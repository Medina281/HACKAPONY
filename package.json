{
  "name": "raiz-directa",
  "version": "1.0.0",
  "description": "Raíz Directa — tablero de oferta relámpago para rescatar perecederos locales (HackPony 2026, Reto 03)",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server.js",
    "seed": "node --disable-warning=ExperimentalWarning scripts/seed.js",
    "demo": "node --disable-warning=ExperimentalWarning scripts/seed.js && node --disable-warning=ExperimentalWarning server.js",
    "fotos": "node scripts/fetch-photos.js",
    "publico": "node --disable-warning=ExperimentalWarning scripts/publico.js",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 test/*.test.js"
  }
}
